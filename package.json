{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.cjs",
    "lint": "eslint js scripts tests playwright.config.cjs",
    "check:html": "html-validate \"*.html\"",
    "check:links": "node scripts/check-links.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run check:html && npm run check:links && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "html-validate": "^11.18.0",
    "jsdom": "^29.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
